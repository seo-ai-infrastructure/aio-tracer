# Set these in your shell/deployment environment; the app does not auto-load .env.
AIO_DATABASE_PATH=data/aio.sqlite
AIO_DATA_DIR=data
AIO_EMBEDDED_WORKER=1
# DATABASE_URL=Postgres connection URL (Neon) for hosted history
# AIO_API_TOKEN=generated operator token for hosted access
# AIO_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# AIO_PROXY_LAKELAND=authenticated city proxy URL (worker only)
# AIO_OBSERVATION_HMAC_KEY=private stable random key for cookie-state fingerprints
